{
  "name": "rocket-shop",
  "version": "0.1.0",
  "private": true,
  "description": "Propellant-tank shop: a cited materials and thin-wall pressure-vessel core, then a three.js tank builder and test stand.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
